# Cache time
CACHE_DURATION=2592000

IMAGE_DRIVER=imagick

EXTENSIONS_IMAGE="jpeg,jpg,png"
MIME_TYPES_IMAGE="image/jpeg,image/png"

EXTENSIONS_DOCUMENTS="pdf"
MIME_TYPES_DOCUMENTS="application/pdf"

EXTENSIONS_ALL_DOCUMENTS="jpeg,jpg,png,pdf,doc,docx"
MIME_ALL_TYPES_DOCUMENTS="image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

