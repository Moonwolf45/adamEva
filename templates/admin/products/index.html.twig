{% extends 'layouts/admin.html.twig' %}

{% block page_name %}
    Товары
{% endblock %}

{% block stylesheets %}
    {{ include('admin/_parts/select2_styles.html.twig') }}
{% endblock %}

{% block body %}
    {% set filter_params = {
        id: filter.id,
        title: filter.title,
        category: filter.category,
        article: filter.article,
        status: filter.status,
        sort: filter.sortBy,
        dir: filter.sortDir,
    } %}

    {% set filter_only_params = {
        id: filter.id,
        title: filter.title,
        category: filter.category,
        article: filter.article,
        status: filter.status,
    } %}

    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title">Фильтр</h3>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('admin_products_index') }}" class="row g-3 align-items-end">
                <input type="hidden" name="sort" value="{{ filter.sortBy }}">
                <input type="hidden" name="dir" value="{{ filter.sortDir }}">

                <div class="col-auto">
                    <label for="filter-id" class="form-label">ID</label>
                    <input type="number" class="form-control" id="filter-id" name="id" min="1" value="{{ filter.id }}">
                </div>

                <div class="col">
                    <label for="filter-title" class="form-label">Название</label>
                    <input type="text" class="form-control" id="filter-title" name="title"
                           value="{{ filter.title }}" placeholder="Поиск по названию">
                </div>

                <div class="col">
                    <label for="filter-category" class="form-label">Категория</label>
                    <select class="form-select select2-category-filter" id="filter-category" name="category"
                            data-placeholder="Выберите категорию...">
                        <option value="">Все</option>
                        {% for category in categoryChoices %}
                            <option value="{{ category.id }}" {{ filter.category == category.id ? ' selected' }}>
                                {% if category.depth > 0 %}
                                    {% for i in 1..category.depth %}&nbsp;-&nbsp;{% endfor %}
                                {% endif %}
                                {{ category.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-auto">
                    <label for="filter-status" class="form-label">Статус</label>
                    <select class="form-select select2-status-filter" id="filter-status" name="status"
                            data-placeholder="Выберите статус...">
                        <option value="">Все</option>
                        <option value="1"{{ filter.status == '1' ? ' selected' }}>Активна</option>
                        <option value="0"{{ filter.status == '0' ? ' selected' }}>Отключена</option>
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Применить</button>
                    <a href="{{ path('admin_products_index') }}" class="btn btn-outline-secondary">Сбросить</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Товары (найдено: {{ total|default(products|length) }})</h3>
            <div class="card-tools">
                <a class="btn btn-primary" href="{{ path('admin_products_new') }}">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Добавить категорию
                </a>
            </div>
        </div>
        <div class="card-body table-responsive p-0">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th style="width: 10px" scope="col">#</th>
                    <th scope="col">
                        {% include 'admin/_parts/sort_link.html.twig' with {
                            label: 'ID',
                            field: 'id',
                            route: 'admin_products_index',
                            params: filter_only_params,
                            sort: filter.sortBy,
                            dir: filter.sortDir,
                        } only %}
                    </th>
                    <th scope="col">
                        {% include 'admin/_parts/sort_link.html.twig' with {
                            label: 'Название',
                            field: 'title',
                            route: 'admin_products_index',
                            params: filter_only_params,
                            sort: filter.sortBy,
                            dir: filter.sortDir,
                        } only %}
                    </th>
                    <th scope="col">
                        {% include 'admin/_parts/sort_link.html.twig' with {
                            label: 'Категория',
                            field: 'category',
                            route: 'admin_products_index',
                            params: filter_only_params,
                            sort: filter.sortBy,
                            dir: filter.sortDir,
                        } only %}
                    </th>
                    <th scope="col">
                        {% include 'admin/_parts/sort_link.html.twig' with {
                            label: 'Статус',
                            field: 'status',
                            route: 'admin_products_index',
                            params: filter_only_params,
                            sort: filter.sortBy,
                            dir: filter.sortDir,
                        } only %}
                    </th>
                    <th scope="col">Дата создания</th>
                    <th scope="col">Дата обновления</th>
                    <th scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for row in products %}
                    <tr class="align-middle">
                        <td>{{ loop.index + (currentPage - 1) * perPage }}</td>
                        <td>{{ row.id }}</td>
                        <td>
                            <a href="{{ path('admin_products_show', {'id': row.id}) }}">{{ row.title }}</a>
                        </td>
                        <td>
                            {% if row.category_id %}
                                {{ row.category_title }}
                            {% else %}
                                <span class="text-secondary">— Без категории —</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if row.status %}
                                <span class="badge text-bg-success">Активна</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Отключена</span>
                            {% endif %}
                        </td>
                        <td>{{ row.created_at|date('d.m.Y H:i') }}</td>
                        <td>{{ row.updated_at|date('d.m.Y H:i') }}</td>
                        <td>
                            {% include 'admin/products/_table_actions.html.twig' with {row: row} only %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">
                            Категории не найдены
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if maxPages > 1 %}
            <div class="card-footer d-flex justify-content-center">
                {% include 'admin/_parts/pagination.html.twig' with {
                    current_page: currentPage,
                    max_pages: maxPages,
                    route: 'admin_products_index',
                    route_paginated: 'admin_products_paginated_index',
                    params: filter_params,
                } only %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascript %}
<script type="module">
    import 'product-select2';
</script>
{% endblock %}
