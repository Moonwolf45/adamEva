{% extends 'layouts/auth.html.twig' %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1>Сброс пароля</h1>

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <div>
            <small>
                {{ 'Enter your email address, and we will send you a link to reset your password.'|trans({}, 'ResetPasswordBundle') }}
            </small>
        </div>

        <button class="btn btn-primary">{{ 'Send password reset email'|trans({}, 'ResetPasswordBundle') }}</button>
    {{ form_end(requestForm) }}
{% endblock %}
